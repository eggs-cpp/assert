{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_COMPILE_WARNING_AS_ERROR": "ON",
        "CMAKE_LINK_WARNING_AS_ERROR": "ON",
        "BUILD_EXAMPLE": "ON",
        "BUILD_TESTING": "ON",
        "ENABLE_INSTALL": "ON"
      }
    },
    {
      "name": "dev-gcc",
      "displayName": "GCC",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      },
      "environment": {
        "CFLAGS": "-ffile-prefix-map=\"${sourceDir}\"=.",
        "CXXFLAGS": "-ffile-prefix-map=\"${sourceDir}\"=."
      }
    },
    {
      "name": "dev-clang",
      "displayName": "Clang",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      },
      "environment": {
        "CFLAGS": "-ffile-prefix-map=\"${sourceDir}\"=.",
        "CXXFLAGS": "-ffile-prefix-map=\"${sourceDir}\"=."
      }
    },
    {
      "name": "dev-clang-libcxx",
      "displayName": "Clang + libc++",
      "inherits": "dev-clang",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      },
      "environment": {
        "CFLAGS": "-ffile-prefix-map=\"${sourceDir}\"=.",
        "CXXFLAGS": "-stdlib=libc++ -ffile-prefix-map=\"${sourceDir}\"=.",
        "LDFLAGS": "-stdlib=libc++"
      }
    },
    {
      "name": "dev-msvc",
      "displayName": "MSVC x64",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      },
      "environment": {
        "CFLAGS": "/std:c11 /d1trimfile:\"${sourceDir}\"",
        "CXXFLAGS": "/d1trimfile:\"${sourceDir}\""
      }
    },
    {
      "name": "dev-clang-cl",
      "displayName": "Clang-CL x64",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl"
      },
      "environment": {
        "CFLAGS": "/clang:-ffile-prefix-map=${sourceDir}=.",
        "CXXFLAGS": "/clang:-ffile-prefix-map=${sourceDir}=."
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev-gcc-debug",
      "displayName": "GCC (Debug)",
      "configurePreset": "dev-gcc",
      "configuration": "Debug"
    },
    {
      "name": "dev-gcc-release",
      "displayName": "GCC (Release)",
      "configurePreset": "dev-gcc",
      "configuration": "Release"
    },
    {
      "name": "dev-clang-debug",
      "displayName": "Clang (Debug)",
      "configurePreset": "dev-clang",
      "configuration": "Debug"
    },
    {
      "name": "dev-clang-release",
      "displayName": "Clang (Release)",
      "configurePreset": "dev-clang",
      "configuration": "Release"
    },
    {
      "name": "dev-clang-libcxx-debug",
      "displayName": "Clang + libc++ (Debug)",
      "configurePreset": "dev-clang-libcxx",
      "configuration": "Debug"
    },
    {
      "name": "dev-clang-libcxx-release",
      "displayName": "Clang + libc++ (Release)",
      "configurePreset": "dev-clang-libcxx",
      "configuration": "Release"
    },
    {
      "name": "dev-msvc-debug",
      "displayName": "MSVC x64 (Debug)",
      "configurePreset": "dev-msvc",
      "configuration": "Debug"
    },
    {
      "name": "dev-msvc-release",
      "displayName": "MSVC x64 (Release)",
      "configurePreset": "dev-msvc",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "dev-gcc-debug",
      "displayName": "GCC (Debug)",
      "configurePreset": "dev-gcc",
      "configuration": "Debug"
    },
    {
      "name": "dev-gcc-release",
      "displayName": "GCC (Release)",
      "configurePreset": "dev-gcc",
      "configuration": "Release"
    },
    {
      "name": "dev-clang-debug",
      "displayName": "Clang (Debug)",
      "configurePreset": "dev-clang",
      "configuration": "Debug"
    },
    {
      "name": "dev-clang-release",
      "displayName": "Clang (Release)",
      "configurePreset": "dev-clang",
      "configuration": "Release"
    },
    {
      "name": "dev-clang-libcxx-debug",
      "displayName": "Clang + libc++ (Debug)",
      "configurePreset": "dev-clang-libcxx",
      "configuration": "Debug"
    },
    {
      "name": "dev-clang-libcxx-release",
      "displayName": "Clang + libc++ (Release)",
      "configurePreset": "dev-clang-libcxx",
      "configuration": "Release"
    },
    {
      "name": "dev-msvc-debug",
      "displayName": "MSVC x64 (Debug)",
      "configurePreset": "dev-msvc",
      "configuration": "Debug"
    },
    {
      "name": "dev-msvc-release",
      "displayName": "MSVC x64 (Release)",
      "configurePreset": "dev-msvc",
      "configuration": "Release"
    }
  ]
}
